generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  fullname  String
  role      Role
  outletId  Int?
  active    Boolean  @default(true)
  lastSeen  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  histories History[]
  sessions  Session[]

  outlet Outlet? @relation(fields: [outletId], references: [id])
}

model Outlet {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  address   String?
  city      String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  purchases  OutletPurchase[]
  receipts   OutletReceipt[]
  stocks     OutletStock[]
  transfers  OutletTransfer[]
  deliveries Delivery[]

  stockOpnames StockOpname[]
  outletBarang OutletBarang[]

  sourceBarangs Barang[] @relation("BarangSourceOutlet")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Supplier {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          String
  address       String?
  city          String?
  phone         String?
  email         String?
  contactPerson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  MasterHarga  MasterHarga[]
  priceSummary PriceSummary[]
  purchases    Purchase[]
  receipts     Receipt[]

  outletPurchases OutletPurchase[]
  outletReceipts  OutletReceipt[]
}

model Customer {
  id            Int        @id @default(autoincrement())
  code          String     @unique
  name          String
  address       String?
  city          String?
  phone         String?
  email         String?
  contactPerson String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deliveries    Delivery[]
}

model Barang {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  barcode        String?  @unique
  name           String
  category       String?
  brand          String?
  unit           String
  minimumStock   Float    @default(0)
  stock          Float    @default(0)
  purchasePrice  Float    @default(0)
  sellingPrice   Float    @default(0)
  hasExpired     Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiredWarning Int      @default(30)

  // ============================================
  // SUMBER BARANG
  // ============================================

  source         BarangSource @default(CENTRAL)
  sourceOutletId Int?

  sourceOutlet Outlet? @relation("BarangSourceOutlet", fields: [sourceOutletId], references: [id])

  adjustmentItems    AdjustmentItem[]
  batches            BarangBatch[]
  batchStocks        BatchStock[]
  deliveryItems      DeliveryItem[]
  inventory          Inventory?
  MasterHarga        MasterHarga[]
  priceSummary       PriceSummary?
  mutationStocks     MutationStock[]
  purchaseItems      PurchaseItem[]
  receiptItems       ReceiptItem[]
  stockCards         StockCard[]
  stockMutations     StockMutation[]
  stockOpnameHistory StockOpnameHistory[]
  stockOpnameItems   StockOpnameItem[]

  outletPurchaseItems OutletPurchaseItem[]
  outletReceiptItems  OutletReceiptItem[]
  outletStocks        OutletStock[]
  outletTransferItems OutletTransferItem[]
  outletBarang        OutletBarang[]

  @@index([source])
  @@index([sourceOutletId])
}

model BarangBatch {
  id          Int      @id @default(autoincrement())
  barangId    Int
  batchNumber String
  expiredDate DateTime
  qty         Float
  createdAt   DateTime @default(now())
  barang      Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
}

model Purchase {
  id           Int            @id @default(autoincrement())
  number       String         @unique
  supplierId   Int
  purchaseDate DateTime       @default(now())
  status       PurchaseStatus @default(DRAFT)
  remarks      String?
  total        Float          @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  items        PurchaseItem[]
  receipts     Receipt[]
}

model PurchaseItem {
  id          Int      @id @default(autoincrement())
  purchaseId  Int
  barangId    Int
  qty         Float
  receivedQty Float    @default(0)
  price       Float
  discount    Float    @default(0)
  tax         Float    @default(0)
  subtotal    Float
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  barang      Barang   @relation(fields: [barangId], references: [id])
}

model OutletPurchase {
  id           Int                  @id @default(autoincrement())
  number       String               @unique
  outletId     Int
  supplierId   Int
  purchaseDate DateTime             @default(now())
  status       OutletPurchaseStatus @default(DRAFT)
  remarks      String?
  total        Float                @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  outlet   Outlet               @relation(fields: [outletId], references: [id])
  supplier Supplier             @relation(fields: [supplierId], references: [id])
  items    OutletPurchaseItem[]
  receipts OutletReceipt[]

  @@index([outletId])
  @@index([supplierId])
}

model OutletPurchaseItem {
  id          Int   @id @default(autoincrement())
  purchaseId  Int
  barangId    Int
  qty         Float
  receivedQty Float @default(0)
  price       Float
  discount    Float @default(0)
  tax         Float @default(0)
  subtotal    Float

  purchase OutletPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  barang   Barang         @relation(fields: [barangId], references: [id])

  @@index([purchaseId])
  @@index([barangId])
}

model OutletReceipt {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  purchaseId  Int
  outletId    Int
  supplierId  Int
  receiptDate DateTime @default(now())
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchase OutletPurchase      @relation(fields: [purchaseId], references: [id])
  outlet   Outlet              @relation(fields: [outletId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    OutletReceiptItem[]

  @@index([outletId])
  @@index([purchaseId])
}

model OutletReceiptItem {
  id        Int   @id @default(autoincrement())
  receiptId Int
  barangId  Int
  qty       Float
  price     Float
  subtotal  Float

  receipt OutletReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  barang  Barang        @relation(fields: [barangId], references: [id])

  @@index([receiptId])
  @@index([barangId])
}

model OutletStock {
  id           Int      @id @default(autoincrement())
  outletId     Int
  barangId     Int
  stock        Float    @default(0)
  minimumStock Float    @default(0)
  averageCost  Float    @default(0)
  updatedAt    DateTime @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  barang Barang @relation(fields: [barangId], references: [id])

  @@unique([outletId, barangId])
  @@index([outletId])
  @@index([barangId])
}

model OutletBarang {
  id        Int      @id @default(autoincrement())
  outletId  Int
  barangId  Int
  harga     Float?   @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  barang Barang @relation(fields: [barangId], references: [id], onDelete: Cascade)

  @@unique([outletId, barangId])
}

model Receipt {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  purchaseId  Int
  supplierId  Int
  receiptDate DateTime      @default(now())
  remarks     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  supplier    Supplier      @relation(fields: [supplierId], references: [id])
  purchase    Purchase      @relation(fields: [purchaseId], references: [id])
  items       ReceiptItem[]
}

model ReceiptItem {
  id        Int     @id @default(autoincrement())
  receiptId Int
  barangId  Int
  qty       Float
  price     Float
  subtotal  Float
  barang    Barang  @relation(fields: [barangId], references: [id])
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model Delivery {
  id           Int            @id @default(autoincrement())
  number       String         @unique
  customerId   Int
  outletId     Int?
  deliveryDate DateTime       @default(now())
  status       DeliveryStatus @default(DRAFT)
  remarks      String?
  totalQty     Float          @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customer   Customer       @relation(fields: [customerId], references: [id])
  outlet     Outlet?        @relation(fields: [outletId], references: [id])
  items      DeliveryItem[]
  suratJalan SuratJalan?
}

model DeliveryItem {
  id         Int      @id @default(autoincrement())
  deliveryId Int
  barangId   Int
  qty        Float
  price      Float    @default(0)
  subtotal   Float    @default(0)
  note       String?
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  barang     Barang   @relation(fields: [barangId], references: [id])
}

model SuratJalan {
  id            Int       @id @default(autoincrement())
  number        String    @unique
  deliveryId    Int       @unique
  driver        String?
  vehicleNumber String?
  expedition    String?
  receiver      String?
  receiveDate   DateTime?
  note          String?
  printed       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  delivery      Delivery  @relation(fields: [deliveryId], references: [id])
}

model StockCard {
  id          Int      @id @default(autoincrement())
  barangId    Int
  trxDate     DateTime @default(now())
  trxType     String
  trxNumber   String
  referenceId Int?
  warehouse   String?  @default("MAIN")
  qtyIn       Float    @default(0)
  qtyOut      Float    @default(0)
  balance     Float
  unitPrice   Float    @default(0)
  totalValue  Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())
  barang      Barang   @relation(fields: [barangId], references: [id])

  @@index([barangId])
  @@index([trxDate])
}

model MutationStock {
  id            Int      @id @default(autoincrement())
  number        String   @unique
  barangId      Int
  fromWarehouse String
  toWarehouse   String
  qty           Float
  mutationDate  DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())
  barang        Barang   @relation(fields: [barangId], references: [id])
}

model Inventory {
  id             Int      @id @default(autoincrement())
  barangId       Int      @unique
  warehouse      String   @default("MAIN")
  stock          Float    @default(0)
  reservedStock  Float    @default(0)
  availableStock Float    @default(0)
  minimumStock   Float    @default(0)
  maximumStock   Float    @default(0)
  lastPurchase   Float    @default(0)
  averageCost    Float    @default(0)
  updatedAt      DateTime @updatedAt
  barang         Barang   @relation(fields: [barangId], references: [id])
}

model StockOpname {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  date       DateTime @default(now())
  status     String   @default("COUNTING")
  createdBy  Int?
  approvedBy Int?
  outletId   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outlet    Outlet?              @relation(fields: [outletId], references: [id])
  histories StockOpnameHistory[]
  items     StockOpnameItem[]

  @@index([outletId])
}

model StockOpnameItem {
  id          Int         @id @default(autoincrement())
  opnameId    Int
  barangId    Int
  systemQty   Float
  physicalQty Float       @default(0)
  difference  Float       @default(0)
  note        String?
  barang      Barang      @relation(fields: [barangId], references: [id])
  opname      StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
}

model Adjustment {
  id             Int              @id @default(autoincrement())
  number         String           @unique
  adjustmentDate DateTime         @default(now())
  warehouse      String           @default("MAIN")
  type           String           @default("IN")
  reason         String?
  remarks        String?
  status         String           @default("DRAFT")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          AdjustmentItem[]
}

model AdjustmentItem {
  id           Int        @id @default(autoincrement())
  adjustmentId Int
  barangId     Int
  qty          Float
  price        Float      @default(0)
  type         String     @default("IN")
  barang       Barang     @relation(fields: [barangId], references: [id])
  adjustment   Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
}

model History {
  id              Int         @id @default(autoincrement())
  transactionType HistoryType
  referenceNumber String?
  description     String
  userId          Int?
  createdAt       DateTime    @default(now())
  user            User?       @relation(fields: [userId], references: [id])
}

model Employee {
  id          Int          @id @default(autoincrement())
  nik         String       @unique
  name        String
  gender      String?
  position    String
  department  String?
  phone       String?
  address     String?
  photo       String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
}

model Attendance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  date       DateTime  @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  photoIn    String?
  photoOut   String?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model BatchStock {
  id          Int      @id @default(autoincrement())
  barangId    Int
  batchNumber String
  expiredDate DateTime
  qty         Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  barang      Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)

  @@index([barangId])
}

model StockMutation {
  id          Int      @id @default(autoincrement())
  barangId    Int
  type        String
  qty         Float
  stockBefore Float
  stockAfter  Float
  reference   String?
  description String?
  createdAt   DateTime @default(now())
  barang      Barang   @relation(fields: [barangId], references: [id])
}

model Company {
  id         Int      @id @default(autoincrement())
  name       String
  logo       String?
  address    String?
  city       String?
  province   String?
  postalCode String?
  phone      String?
  email      String?
  website    String?
  npwp       String?
  director   String?
  footer     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DocumentNumber {
  id         Int      @id @default(autoincrement())
  type       String
  prefix     String
  period     String
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([type, period])
}

model StockOpnameHistory {
  id          Int         @id @default(autoincrement())
  opnameId    Int
  barangId    Int
  systemQty   Float
  physicalQty Float
  difference  Float
  createdBy   Int?
  createdAt   DateTime    @default(now())
  barang      Barang      @relation(fields: [barangId], references: [id])
  opname      StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
}

model MasterHarga {
  id Int @id @default(autoincrement())

  barangId   Int
  supplierId Int

  purchaseId     Int?
  purchaseItemId Int?

  poNumber String?

  hargaLama Float
  hargaBaru Float

  selisihHarga Float @default(0)
  persenNaik   Float @default(0)

  qty   Float @default(0)
  total Float @default(0)

  akumulasi Float @default(0)

  status String

  receiveDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang   Barang   @relation(fields: [barangId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([barangId])
  @@index([supplierId])
}

model PriceSummary {
  id Int @id @default(autoincrement())

  barangId Int @unique

  supplierId Int?

  lastPrice Float @default(0)

  averagePrice Float @default(0)

  highestPrice Float @default(0)

  lowestPrice Float @default(0)

  totalPurchase Float @default(0)

  lastReceiveDate DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  barang Barang @relation(fields: [barangId], references: [id])

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

model OutletTransfer {
  id           Int                  @id @default(autoincrement())
  number       String               @unique
  outletId     Int
  transferDate DateTime             @default(now())
  status       OutletTransferStatus @default(SENT)
  remarks      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  outlet Outlet               @relation(fields: [outletId], references: [id])
  items  OutletTransferItem[]

  @@index([outletId])
}

model OutletTransferItem {
  id          Int   @id @default(autoincrement())
  transferId  Int
  barangId    Int
  qty         Float
  receivedQty Float @default(0)

  transfer OutletTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  barang   Barang         @relation(fields: [barangId], references: [id])

  @@index([transferId])
  @@index([barangId])
}

enum Role {
  ADMIN
  MANAGER
  PURCHASING
  GUDANG
  OUTLET_ADMIN
}

enum BarangSource {
  CENTRAL
  OUTLET
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  RECEIVED
}

enum DeliveryStatus {
  DRAFT
  RELEASED
  DELIVERED
}

enum AdjustmentType {
  PLUS
  MINUS
}

enum HistoryType {
  MASTER_CREATE
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  PURCHASE
  RECEIPT
  DELIVERY
  STOCK_OPNAME
}

enum OutletPurchaseStatus {
  DRAFT
  APPROVED
  RECEIVED
}

enum OutletTransferStatus {
  SENT
  PARTIAL
  RECEIVED
}
